@startuml class-diagram
' Restaurant Rush class diagram, v1 (design draft).
' Edit this file, then re-render:
'   java -jar plantuml.jar docs/class-diagram.puml
' Keep it in step with the code at each stage tag.

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
skinparam defaultFontName Helvetica
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #555555
  ArrowColor #555555
}
skinparam note {
  BackgroundColor #FFF8DC
  BorderColor #B8A040
}

title Restaurant Rush: class diagram (v5 draft)

package "Boundary" #F4F4F4 {
  class ConsoleUI {
    - controller : GameController
    - input : InputReader
    + run() : void
    - playTurn() : void
    - showTurnStart(s : GameSnapshot) : void
    - showTurnEnd(s : GameSnapshot) : void
    - askUntilAccepted(choice : Supplier<ActionResult>) : void
    ~ {static} money(cents : int) : String
  }

  class InputReader {
    - scanner : Scanner
    - echo : boolean
    + readInt(prompt : String, min : int, max : int) : int
    + readCustomerId(prompt : String) : int
  }
}

package "Control" #F4F4F4 {
  class GameController {
    + {static} MAX_TURNS : int = 18
    + {static} TABLE_COUNT : int = 2
    - turn : int
    + startTurn() : List<String>
    + snapshot() : GameSnapshot
    + waiterSeat(customerId : int) : ActionResult
    + waiterTakeOrder(customerId : int) : ActionResult
    + waiterServe(customerId : int) : ActionResult
    + waiterWait() : ActionResult
    + chefWork(customerId : int) : ActionResult
    + chefWait() : ActionResult
    + endTurn() : List<String>
    + isGameOver() : boolean
    + isVictory() : boolean
  }

  class GameSnapshot <<record>> {
    + turn : int
    + revenueCents : int
    + averageSatisfaction : OptionalDouble
    + paidCount : int
    + servedCount : int
    + departures : int
  }

  class CustomerView <<record>> {
    + id : int
    + type : String
    + satisfaction : int
    + status : String
    + item : String
    + unitsDone : int
    + unitsTotal : int
    + orderStatus : String
  }

  class TableView <<record>> {
    + number : int
    + isFree() : boolean
  }

  class ActionResult <<record>> {
    + ok : boolean
    + message : String
    + {static} success(m : String) : ActionResult
    + {static} failure(r : String) : ActionResult
  }

  class ArrivalSchedule {
    - {static} ARRIVAL_TURNS : int[]
    - {static} ARRIVAL_TYPES : List<IntFunction<Customer>>
    - nextId : int
    + customerArrivingOn(turn : int) : Optional<Customer>
  }
}

package "Entity" #F4F4F4 {
  class Restaurant {
    + {static} TARGET_PAID : int = 4
    + {static} TARGET_REVENUE_CENTS : int = 4500
    + {static} TARGET_SATISFACTION : int = 60
    - queue : Deque<Customer>
    - paidCustomers : List<Customer>
    - revenueCents : int
    - servedCount : int
    - departures : int
    + addArrival(c : Customer) : void
    + seat(c : Customer, t : Table) : void
    + recordServed() : void
    + recordPayment(c : Customer) : void
    + recordDeparture(c : Customer) : void
    + findPresentCustomer(id : int) : Optional<Customer>
    + presentCustomers() : List<Customer>
    + freeTable() : Optional<Table>
    + tableOf(c : Customer) : Optional<Table>
    + averageSatisfaction() : OptionalDouble
    + isVictory() : boolean
    + getMenu() : Menu
  }

  class Table {
    - number : int
    - occupant : Customer
    + isFree() : boolean
    + seat(c : Customer) : void
    + clear() : void
  }

  abstract class Customer {
    + {static} MAX_SATISFACTION : int = 100
    - id : int
    - satisfaction : int
    - status : CustomerStatus
    - servedTurn : int
    - readyToPayTurn : int
    + {abstract} waitingPenalty() : int
    + {abstract} typeName() : String
    + discountPercent() : int
    + chooseFood(menu : Menu) : Orderable
    + billFor(dish : Orderable) : int
    # onServed(o : Order, turn : int) : String
    + seat() : void
    + placeOrder(o : Order) : void
    + receiveDish(turn : int) : String
    + finishEatingIfDone(turn : int) : boolean
    + canPay(turn : int) : boolean
    + pay() : void
    + applyWaitingLoss() : boolean
    # adjustSatisfaction(change : int) : void
  }

  class RegularCustomer {
    + waitingPenalty() : int
    + typeName() : String
  }

  class VIPCustomer <<Stage 2>> #E8F0FE {
    - {static} PENALTY : int = 12
    - {static} DISCOUNT_PERCENT : int = 10
    + waitingPenalty() : int
    + discountPercent() : int
    + typeName() : String
  }

  class CriticCustomer <<Stage 2>> #E8F0FE {
    - {static} PENALTY : int = 10
    + {static} GOOD_REVIEW_THRESHOLD : int = 70
    + {static} REVIEW_SWING : int = 15
    + waitingPenalty() : int
    + typeName() : String
    # onServed(o : Order, turn : int) : String
  }

  class Order {
    - item : Orderable
    - billCents : int
    - unitsDone : int
    - status : OrderStatus
    + Order(item : Orderable, billCents : int)
    + advance() : void
    + serve() : void
    + markPaid() : void
    + cancel() : void
    + isReady() : boolean
    + getUnitsTotal() : int
  }

  interface Orderable {
    + displayName() : String
    + priceCents() : int
    + prepUnits() : int
  }

  enum MenuItem {
    SALAD
    BURGER
    PASTA
    - displayName : String
    - priceCents : int
    - prepUnits : int
  }

  class ComboMeal <<Stage 3>> #FDEBD0 {
    - first : Orderable
    - second : Orderable
    + priceCents() : int
    + prepUnits() : int
  }

  class Menu {
    + items() : List<Orderable>
  }

  class OrderGenerator <<utility>> {
    + {static} SEED : long = 42
    + {static} chooseDish(menu : Menu) : Orderable
  }

  class Money <<utility>> {
    + {static} format(cents : int) : String
    + {static} discount(cents : int, percent : int) : int
  }

  class HappyHour <<Stage 3>> #FDEBD0 {
    - turnsLeft : int
    - used : boolean
    + activate() : ActionResult
    + isActive() : boolean
    + tick() : void
  }

  abstract class StaffMember {
    - usedThisTurn : boolean
    + resetForTurn() : void
    + hasActed() : boolean
    + skipTurn() : void
    # markUsed() : void
  }

  class Waiter {
    + seat(r : Restaurant, c : Customer, t : Table) : ActionResult
    + takeOrder(c : Customer, menu : Menu) : ActionResult
    + serve(c : Customer, turn : int) : ActionResult
  }
  class Chef {
    + prepare(customerId : int, o : Order) : ActionResult
  }
  class Cashier {
    + collectPayment(r : Restaurant, turn : int) : Optional<Customer>
  }
  class Host <<Stage 3>> #FDEBD0 {
    + seat(c : Customer, t : Table) : ActionResult
  }

  enum CustomerStatus {
    WAITING
    SEATED
    ORDERED
    SERVED
    READY_TO_PAY
    PAID
    LEFT
  }

  enum OrderStatus {
    IN_PREPARATION
    READY
    SERVED
    PAID
    CANCELLED
  }
}

' ---- Relationships ----
ConsoleUI --> "1" GameController : sends choices to
ConsoleUI *-- "1" InputReader
ConsoleUI ..> GameSnapshot : displays
GameController ..> GameSnapshot : builds
GameSnapshot *-- "0..*" CustomerView : waitingQueue
GameSnapshot *-- "2" TableView : tables
TableView --> "0..1" CustomerView : occupant
GameController ..> ActionResult : returns
GameController --> "1" ArrivalSchedule
ArrivalSchedule ..> Customer : creates
GameController --> "1" Restaurant
GameController --> "0..1" HappyHour
GameController *-- "1..*" StaffMember : staff

Restaurant *-- "2" Table
Restaurant o-- "0..*" Customer
Restaurant --> "1" Menu
Table --> "0..1" Customer : occupant

Customer <|-- RegularCustomer
Customer <|-- VIPCustomer
Customer <|-- CriticCustomer
Customer --> "0..1" Order
Customer --> CustomerStatus

Order --> "1" Orderable : item
Order --> OrderStatus
Menu o-- "3..*" Orderable
Customer ..> OrderGenerator : chooseFood() uses

Orderable <|.. MenuItem
Orderable <|.. ComboMeal
ComboMeal *-- "2" Orderable : components

StaffMember <|-- Waiter
StaffMember <|-- Chef
StaffMember <|-- Cashier
StaffMember <|-- Host

Waiter ..> Order : serves
Chef ..> Order : prepares
Cashier ..> Customer : charges
Host ..> Table : seats at

' ---- Annotations for the marking criteria ----
note right of Customer
  <b>Polymorphism</b>: GameController calls
  waitingPenalty(), discountPercent() and
  onServed() without checking the type.
  New customer types need no controller change.
end note

note bottom of CriticCustomer
  <b>Critic review</b> (onServed): satisfaction
  >= 70 when served: +15; below 70: -15.
end note

note bottom of ComboMeal
  <b>Composition</b>: a combo is built from two
  Orderables; price = 90% of their sum,
  units = sum of their units.
end note

note top of StaffMember
  <b>Inheritance</b>: each staff member is limited
  to one task per turn through usedThisTurn,
  reset by resetForTurn() at the start of a turn.
end note

note right of GameSnapshot
  <b>Encapsulation</b>: the UI only receives
  read-only records, never real entities,
  so it cannot change game state.
end note

note left of Order
  <b>Encapsulation</b>: status changes only
  through advance(), serve(), markPaid() and
  cancel(); the bill is locked in the constructor.
end note

legend right
  White: Stage 1
  Blue: added in Stage 2
  Orange: added in Stage 3
endlegend

@enduml
